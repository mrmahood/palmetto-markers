# Copy to .env for local development. None of these are required to run the
# public atlas (map, lessons, scan). Auth is off until you set a real issuer.

# VITE_AUTH_ENABLED=false

# GROK_AUTH_ISSUER=
# GROK_AUTH_CLIENT_ID=
# GROK_AUTH_CLIENT_SECRET=
# BETTER_AUTH_URL=http://localhost:8080
# DATABASE_URL=
# XAI_API_KEY=
